<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= content.site.companyName %></title>
  <% if (content.site.metaDescription) { %>
  <meta name="description" content="<%= content.site.metaDescription %>">
  <meta property="og:title" content="<%= title %> · <%= content.site.companyName %>">
  <meta property="og:description" content="<%= content.site.metaDescription %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= content.site.companyName %>">
  <meta name="twitter:card" content="summary_large_image">
  <% } %>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">
        <span class="brand-mark">⬢</span>
        <span class="brand-name"><%= content.site.companyName %></span>
      </a>
      <nav class="nav" id="main-nav">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/projects">Projects</a>
        <a href="/videos">Videos</a>
        <a href="/contact">Contact</a>
      </nav>
      <a class="btn btn-primary header-cta" href="/contact">Get a Quote</a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu">☰</button>
    </div>
  </header>
  <main>
