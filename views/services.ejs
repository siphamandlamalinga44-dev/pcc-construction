<%- include('partials/head', { title: title }) %>

<section class="page-hero">
  <div class="container">
    <span class="eyebrow eyebrow-light">Services</span>
    <h1>Full-service construction, under one roof</h1>
    <p>From the first earthworks to final handover, we cover every stage of your project.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid-2 services-grid">
      <% content.services.forEach(function(s) { %>
        <div class="card service-card">
          <% if (s.image) { %>
            <div class="service-photo">
              <img src="<%= s.image %>" alt="<%= s.title %>">
              <% if (s.image2) { %>
                <img class="service-photo-2" src="<%= s.image2 %>" alt="<%= s.title %> (more)">
              <% } %>
            </div>
          <% } %>
          <div class="service-card-body">
            <div class="card-icon"><%= s.icon %></div>
            <h3><%= s.title %></h3>
            <p><%= s.description %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="container cta-inner">
    <h2>Not sure which service fits your project?</h2>
    <p>Tell us what you have in mind — we will point you in the right direction.</p>
    <a class="btn btn-light btn-lg" href="/contact">Talk to us</a>
  </div>
</section>

<%- include('partials/footer') %>
