<%- include('partials/head', { title: title }) %>

<section class="page-hero">
  <div class="container">
    <span class="eyebrow eyebrow-light">About Us</span>
    <h1>Building with integrity and quality workmanship</h1>
    <p><%= content.site.tagline %></p>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <% content.about.body.forEach(function(para) { %>
      <p class="lead"><%= para %></p>
    <% }) %>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <span class="eyebrow">The strengths behind every build</span>
    <h2 class="section-heading">Why clients choose us</h2>
    <div class="grid-3">
      <% content.home.whyChooseUs.forEach(function(w) { %>
        <div class="card">
          <h3><%= w.title %></h3>
          <p><%= w.text %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<% if (content.about.team && content.about.team.length) { %>
<section class="section">
  <div class="container two-col team-section">
    <div class="team-photo">
      <% if (content.about.teamImage) { %>
        <img src="<%= content.about.teamImage %>" alt="<%= content.about.team[0].name %>">
      <% } else { %>
        <div class="thumb-placeholder"><span>Team photo</span></div>
      <% } %>
    </div>
    <div>
      <span class="eyebrow">Meet the team</span>
      <h2 class="section-heading"><%= content.about.team[0].name %></h2>
      <p class="team-role"><%= content.about.team[0].role %></p>
      <p class="lead"><%= content.about.team[0].bio %></p>
      <a class="btn btn-outline" href="/contact">Start your project</a>
    </div>
  </div>
</section>
<% } %>

<section class="cta-band">
  <div class="container cta-inner">
    <h2>Want to work with us?</h2>
    <a class="btn btn-light btn-lg" href="/contact">Get a Free Quote</a>
  </div>
</section>

<%- include('partials/footer') %>
