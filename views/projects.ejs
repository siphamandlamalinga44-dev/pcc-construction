<%- include('partials/head', { title: title }) %>

<section class="page-hero">
  <div class="container">
    <span class="eyebrow eyebrow-light">Projects</span>
    <h1>Our work</h1>
    <p>A selection of builds delivered by PC Chauke Construction and Projects CC — across all provinces of South Africa.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="gallery-filters" id="gallery-filters">
      <button class="filter-btn is-active" data-cat="all">All</button>
      <% const cats = []; content.projects.forEach(function(p) { if (p.category && cats.indexOf(p.category) === -1) cats.push(p.category); }); %>
      <% cats.forEach(function(cat) { %>
        <button class="filter-btn" data-cat="<%= cat %>"><%= cat %></button>
      <% }) %>
    </div>

    <div class="gallery-grid" id="gallery-grid">
      <% content.projects.forEach(function(p) { %>
        <% const imgs = (p.images && p.images.length) ? p.images : (p.image ? [p.image] : []); %>
        <article class="gallery-card" data-cat="<%= p.category || '' %>">
          <div class="gallery-media">
            <% if (imgs.length) { %>
              <div class="gallery-img-wrap"><img src="<%= imgs[0] %>" alt="<%= p.title %>" class="gallery-img" onclick="openLightbox(<%- JSON.stringify(imgs).replace(/"/g, "'") %>, '<%= p.title %>')"></div>
            <% } else { %>
              <div class="thumb-placeholder gallery-img"><span><%= p.category %></span></div>
            <% } %>
            <% if (imgs.length > 1) { %>
              <span class="gallery-count">🖼 <%= imgs.length %> photos</span>
            <% } %>
            <% if (p.video) { %>
              <span class="gallery-video-badge">▶ Video</span>
              <%- include('partials/video', { video: p.video }) %>
            <% } %>
          </div>
          <div class="gallery-body">
            <span class="gallery-cat"><%= p.category %> · <%= p.date %></span>
            <h3><%= p.title %></h3>
            <p><%= p.description %></p>
          </div>
        </article>
      <% }) %>
      <% if (!content.projects.length) { %>
        <p class="muted">No projects yet — add some in the admin panel.</p>
      <% } %>
    </div>
  </div>
</section>

<div class="lightbox" id="lightbox" onclick="closeLightbox()">
  <button class="lightbox-close" onclick="closeLightbox()" aria-label="Close">✕</button>
  <% if (content.projects.length) { %>
    <button class="lightbox-nav lightbox-prev" onclick="lbStep(-1)" aria-label="Previous">‹</button>
  <% } %>
  <div class="lightbox-inner" onclick="event.stopPropagation()">
    <img id="lightbox-img" src="" alt="">
    <p class="lightbox-caption" id="lightbox-caption"></p>
    <% if (content.projects.length) { %>
      <div class="lightbox-thumbs" id="lightbox-thumbs"></div>
    <% } %>
  </div>
  <% if (content.projects.length) { %>
    <button class="lightbox-nav lightbox-next" onclick="lbStep(1)" aria-label="Next">›</button>
  <% } %>
</div>

<script>
  var lbImages = [];
  var lbIndex = 0;
  function openLightbox(images, caption) {
    lbImages = images || [];
    lbIndex = 0;
    renderLightbox(caption);
    var box = document.getElementById('lightbox');
    box.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function renderLightbox(caption) {
    var img = document.getElementById('lightbox-img');
    var cap = document.getElementById('lightbox-caption');
    var thumbs = document.getElementById('lightbox-thumbs');
    if (!lbImages.length) return;
    img.src = lbImages[lbIndex];
    img.style.display = 'block';
    cap.textContent = caption + '  —  ' + (lbIndex + 1) + ' / ' + lbImages.length;
    thumbs.innerHTML = lbImages.map(function (src, i) {
      return '<img src="' + src + '" class="' + (i === lbIndex ? 'active' : '') + '" onclick="lbGo(' + i + ')">';
    }).join('');
  }
  function lbGo(i) { lbIndex = i; renderLightbox(document.getElementById('lightbox-caption').textContent.split('  —  ')[0]); }
  function lbStep(d) { lbIndex = (lbIndex + d + lbImages.length) % lbImages.length; renderLightbox(document.getElementById('lightbox-caption').textContent.split('  —  ')[0]); }
  function closeLightbox() {
    var box = document.getElementById('lightbox');
    box.classList.remove('open');
    document.body.style.overflow = '';
  }
  document.addEventListener('keydown', function (e) {
    if (!document.getElementById('lightbox').classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') lbStep(-1);
    if (e.key === 'ArrowRight') lbStep(1);
  });
  document.querySelectorAll('.filter-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.filter-btn').forEach(function (b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
      var cat = btn.getAttribute('data-cat');
      document.querySelectorAll('.gallery-card').forEach(function (card) {
        card.style.display = (cat === 'all' || card.getAttribute('data-cat') === cat) ? '' : 'none';
      });
    });
  });
</script>

<%- include('partials/footer') %>
