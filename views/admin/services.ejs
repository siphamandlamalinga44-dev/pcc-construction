<%- include('_head', { title: title }) %>

<h1>Services</h1>
<p class="muted">Add, edit or delete the services shown on the Services page and home page.</p>

<div class="admin-split">
  <div class="admin-list">
    <% services.forEach(function(s) { %>
      <div class="admin-row">
        <div class="admin-row-icon"><%= s.icon %></div>
        <div class="admin-row-main">
          <strong><%= s.title %></strong>
          <span class="muted small"><%= s.description %></span>
        </div>
        <button class="btn btn-outline btn-sm" onclick="editService('<%= s.id %>', '<%= (s.icon||'').replace(/'/g, "\\'") %>', '<%= s.title.replace(/'/g, "\\'") %>', '<%= s.description.replace(/'/g, "\\'") %>')">Edit</button>
        <form method="post" action="/admin/services/delete" style="display:inline" onsubmit="return confirm('Delete this service?')">
          <input type="hidden" name="id" value="<%= s.id %>">
          <button type="submit" class="btn btn-danger btn-sm">Delete</button>
        </form>
      </div>
    <% }) %>
    <% if (!services.length) { %><p class="muted">No services yet.</p><% } %>
  </div>

  <div class="admin-form-card">
    <h3>Add / Edit Service</h3>
    <form method="post" action="/admin/services/save" id="service-form">
      <input type="hidden" name="id" id="service-id" value="">
      <div class="field"><label>Icon (emoji or symbol)</label><input type="text" name="icon" id="service-icon" value="🏗️"></div>
      <div class="field"><label>Title</label><input type="text" name="title" id="service-title" required></div>
      <div class="field"><label>Description</label><textarea name="description" id="service-description" rows="4" required></textarea></div>
      <button type="submit" class="btn btn-primary">Save Service</button>
      <button type="button" class="btn btn-outline" onclick="clearService()">Clear</button>
    </form>
  </div>
</div>

<script>
  function editService(id, icon, title, description) {
    document.getElementById('service-id').value = id;
    document.getElementById('service-icon').value = icon;
    document.getElementById('service-title').value = title;
    document.getElementById('service-description').value = description;
  }
  function clearService() {
    document.getElementById('service-form').reset();
    document.getElementById('service-id').value = '';
  }
</script>

<%- include('_foot') %>
