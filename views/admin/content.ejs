<%- include('_head', { title: title }) %>

<h1>Website Text</h1>
<p class="muted">Edit any field below — changes save instantly and go live on the website.</p>

<form method="post" action="/admin/content">
  <fieldset class="admin-fieldset">
    <legend>Company details</legend>
    <div class="field-row">
      <div class="field"><label>Company name</label><input type="text" name="site.companyName" value="<%= content.site.companyName %>"></div>
      <div class="field"><label>Tagline</label><input type="text" name="site.tagline" value="<%= content.site.tagline %>"></div>
    </div>
    <div class="field-row">
      <div class="field"><label>Phone</label><input type="text" name="site.phone" value="<%= content.site.phone %>"></div>
      <div class="field"><label>Email</label><input type="email" name="site.email" value="<%= content.site.email %>"></div>
    </div>
    <div class="field-row">
      <div class="field"><label>Address</label><input type="text" name="site.address" value="<%= content.site.address %>"></div>
      <div class="field"><label>Established</label><input type="text" name="site.established" value="<%= content.site.established %>"></div>
    </div>
  </fieldset>

  <fieldset class="admin-fieldset">
    <legend>Home hero</legend>
    <div class="field"><label>Hero title</label><input type="text" name="hero.title" value="<%= content.hero.title %>"></div>
    <div class="field"><label>Hero subtitle</label><textarea name="hero.subtitle" rows="3"><%= content.hero.subtitle %></textarea></div>
    <div class="field"><label>Button text</label><input type="text" name="hero.ctaText" value="<%= content.hero.ctaText %>"></div>
  </fieldset>

  <fieldset class="admin-fieldset">
    <legend>Home page</legend>
    <div class="field"><label>About preview text</label><textarea name="home.aboutPreview" rows="3"><%= content.home.aboutPreview %></textarea></div>

    <h3 class="subhead">Stats</h3>
    <% for (let i = 1; i <= 4; i++) { const s = content.home.stats[i-1]; %>
      <div class="field-row">
        <div class="field"><label>Stat value <%= i %></label><input type="text" name="stat.value<%= i %>" value="<%= s ? s.value : '' %>"></div>
        <div class="field"><label>Stat label <%= i %></label><input type="text" name="stat.label<%= i %>" value="<%= s ? s.label : '' %>"></div>
      </div>
    <% } %>

    <h3 class="subhead">Why choose us (3 items)</h3>
    <% for (let i = 1; i <= 3; i++) { const w = content.home.whyChooseUs[i-1]; %>
      <div class="field-row">
        <div class="field"><label>Title <%= i %></label><input type="text" name="why.title<%= i %>" value="<%= w ? w.title : '' %>"></div>
        <div class="field"><label>Text <%= i %></label><input type="text" name="why.text<%= i %>" value="<%= w ? w.text : '' %>"></div>
      </div>
    <% } %>
  </fieldset>

  <fieldset class="admin-fieldset">
    <legend>About page</legend>
    <p class="muted small">Each block becomes one paragraph. Empty blocks are removed.</p>
    <% for (let i = 1; i <= 6; i++) { const p = content.about.body[i-1] || ''; %>
      <div class="field">
        <label>Paragraph <%= i %></label>
        <textarea name="about.body<%= i %>" rows="3"><%= p %></textarea>
      </div>
    <% } %>
  </fieldset>

  <fieldset class="admin-fieldset">
    <legend>Contact page</legend>
    <div class="field"><label>Intro text</label><textarea name="contact.intro" rows="3"><%= content.contact.intro %></textarea></div>
    <div class="field"><label>Hours</label><input type="text" name="contact.hours" value="<%= content.contact.hours %>"></div>
  </fieldset>

  <fieldset class="admin-fieldset">
    <legend>Footer</legend>
    <div class="field"><label>Footer text</label><textarea name="footer.text" rows="3"><%= content.footer.text %></textarea></div>
    <div class="field"><label>Copyright line</label><input type="text" name="footer.copyright" value="<%= content.footer.copyright %>"></div>
  </fieldset>

  <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
</form>

<%- include('_foot') %>
