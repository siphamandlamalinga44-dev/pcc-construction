<%- include('_head', { title: title }) %>

<h1>Website Text</h1>
<p class="muted">Edit any field below — changes save instantly and go live on the website.</p>

<form method="post" action="/admin/content">
  <fieldset class="admin-fieldset">
    <legend>Company details</legend>
    <div class="field-row">
      <div class="field"><label>Company name</label><input type="text" name="site.companyName" value="<%= content.site.companyName %>"></div>
      <div class="field"><label>Tagline</label><input type="text" name="site.tagline" value="<%= content.site.tagline %>"></div>
    </div>
    <div class="field-row">
      <div class="field"><label>Phone</label><input type="text" name="site.phone" value="<%= content.site.phone %>"></div>
      <div class="field"><label>WhatsApp number</label><input type="text" name="site.whatsapp" value="<%= content.site.whatsapp %>" placeholder="+27 82 123 4567"></div>
    </div>
    <div class="field-row">
      <div class="field"><label>Email</label><input type="email" name="site.email" value="<%= content.site.email %>"></div>
      <div class="field"><label>Address</label><input type="text" name="site.address" value="<%= content.site.address %>"></div>
    </div>
  </fieldset>

  <fieldset class="admin-fieldset">
    <legend>Search engines (SEO)</legend>
    <p class="muted small">The short description search engines show under your site name in results.</p>
    <div class="field"><label>Meta description</label><textarea name="site.metaDescription" rows="3"><%= content.site.metaDescription %></textarea></div>
  </fieldset>

  <fieldset class="admin-fieldset">
    <legend>Home hero</legend>
    <div class="field"><label>Hero title</label><input type="text" name="hero.title" value="<%= content.hero.title %>"></div>
    <div class="field"><label>Hero subtitle</label><textarea name="hero.subtitle" rows="3"><%= content.hero.subtitle %></textarea></div>
    <div class="field"><label>Button text</label><input type="text" name="hero.ctaText" value="<%= content.hero.ctaText %>"></div>
  </fieldset>

  <fieldset class="admin-fieldset">
    <legend>Home page</legend>
    <div class="field"><label>About preview text</label><textarea name="home.aboutPreview" rows="3"><%= content.home.aboutPreview %></textarea></div>

    <h3 class="subhead">Stats</h3>
    <% for (let i = 1; i <= 4; i++) { const s = content.home.stats[i-1]; %>
      <div class="field-row">
        <div class="field"><label>Stat value <%= i %></label><input type="text" name="stat.value<%= i %>" value="<%= s ? s.value : '' %>"></div>
        <div class="field"><label>Stat label <%= i %></label><input type="text" name="stat.label<%= i %>" value="<%= s ? s.label : '' %>"></div>
      </div>
    <% } %>

    <h3 class="subhead">Why choose us (3 items)</h3>
    <% for (let i = 1; i <= 3; i++) { const w = content.home.whyChooseUs[i-1]; %>
      <div class="field-row">
        <div class="field"><label>Title <%= i %></label><input type="text" name="why.title<%= i %>" value="<%= w ? w.title : '' %>"></div>
        <div class="field"><label>Text <%= i %></label><input type="text" name="why.text<%= i %>" value="<%= w ? w.text : '' %>"></div>
      </div>
    <% } %>
  </fieldset>

  <fieldset class="admin-fieldset">
    <legend>About page</legend>
    <p class="muted small">Each block becomes one paragraph. Empty blocks are removed.</p>
    <% for (let i = 1; i <= 6; i++) { const p = content.about.body[i-1] || ''; %>
      <div class="field">
        <label>Paragraph <%= i %></label>
        <textarea name="about.body<%= i %>" rows="3"><%= p %></textarea>
      </div>
    <% } %>
  </fieldset>

  <h3 class="subhead">Team member</h3>
  <div class="field-row">
    <div class="field"><label>Name</label><input type="text" name="team.name" value="<%= content.about.team && content.about.team[0] ? content.about.team[0].name : '' %>"></div>
    <div class="field"><label>Role</label><input type="text" name="team.role" value="<%= content.about.team && content.about.team[0] ? content.about.team[0].role : '' %>"></div>
  </div>
  <div class="field"><label>Bio</label><textarea name="team.bio" rows="4"><%= content.about.team && content.about.team[0] ? content.about.team[0].bio : '' %></textarea></div>
  <div class="field"><label>Team photo URL</label><input type="text" name="about.teamImage" value="<%= content.about.teamImage %>" placeholder="/images/your-photo.jpg"></div>

  <fieldset class="admin-fieldset">
    <legend>Contact page</legend>
    <div class="field"><label>Intro text</label><textarea name="contact.intro" rows="3"><%= content.contact.intro %></textarea></div>
    <div class="field"><label>Hours</label><input type="text" name="contact.hours" value="<%= content.contact.hours %>"></div>
  </fieldset>

  <fieldset class="admin-fieldset">
    <legend>Social media</legend>
    <p class="muted small">Paste the full link for each account. For WhatsApp you can enter just your number (e.g. 079 708 9314) — it is turned into a working wa.me link automatically. Leaving a field empty keeps that icon greyed out on the site.</p>
    <div class="field-row">
      <div class="field"><label>Facebook link</label><input type="text" name="social.facebook" value="<%= (content.footer.socials || []).find(function(s){return s.icon==='facebook'}) ? (content.footer.socials.find(function(s){return s.icon==='facebook'}).url || '') : '' %>"></div>
      <div class="field"><label>Instagram link</label><input type="text" name="social.instagram" value="<%= (content.footer.socials || []).find(function(s){return s.icon==='instagram'}) ? (content.footer.socials.find(function(s){return s.icon==='instagram'}).url || '') : '' %>"></div>
    </div>
    <div class="field-row">
      <div class="field"><label>WhatsApp number or link</label><input type="text" name="social.whatsapp" placeholder="079 708 9314 or https://wa.me/…" value="<%= (content.footer.socials || []).find(function(s){return s.icon==='whatsapp'}) ? (content.footer.socials.find(function(s){return s.icon==='whatsapp'}).url || '') : '' %>"></div>
      <div class="field"><label>X (Twitter) link</label><input type="text" name="social.x" value="<%= (content.footer.socials || []).find(function(s){return s.icon==='x'}) ? (content.footer.socials.find(function(s){return s.icon==='x'}).url || '') : '' %>"></div>
    </div>
    <div class="field"><label>LinkedIn link</label><input type="text" name="social.linkedin" value="<%= (content.footer.socials || []).find(function(s){return s.icon==='linkedin'}) ? (content.footer.socials.find(function(s){return s.icon==='linkedin'}).url || '') : '' %>"></div>
  </fieldset>

  <fieldset class="admin-fieldset">
    <legend>Footer</legend>
    <div class="field"><label>Footer text</label><textarea name="footer.text" rows="3"><%= content.footer.text %></textarea></div>
    <div class="field"><label>Copyright line</label><input type="text" name="footer.copyright" value="<%= content.footer.copyright %>"></div>
    <h3 class="subhead">SARS badge</h3>
    <div class="field-row">
      <div class="field"><label>Badge title</label><input type="text" name="footer.sarsTitle" value="<%= content.footer.sarsTitle %>"></div>
      <div class="field"><label>Badge subtitle</label><input type="text" name="footer.sarsSub" value="<%= content.footer.sarsSub %>"></div>
    </div>
  </fieldset>

  <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
</form>

<%- include('_foot') %>
