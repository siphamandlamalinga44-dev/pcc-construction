<%- include('_head', { title: title }) %>

<h1>Change Admin Password</h1>
<p class="muted">This password protects the admin panel where you edit the website.</p>

<% if (success) { %><div class="alert alert-success">Password updated successfully.</div><% } %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<form method="post" action="/admin/password" class="admin-form-card" style="max-width:420px">
  <div class="field">
    <label for="current">Current password</label>
    <input type="password" id="current" name="current" required>
  </div>
  <div class="field">
    <label for="next">New password (min 6 characters)</label>
    <input type="password" id="next" name="next" required>
  </div>
  <div class="field">
    <label for="confirm">Confirm new password</label>
    <input type="password" id="confirm" name="confirm" required>
  </div>
  <button type="submit" class="btn btn-primary">Update Password</button>
</form>

<%- include('_foot') %>
