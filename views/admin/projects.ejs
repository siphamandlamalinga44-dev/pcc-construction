<%- include('_head', { title: title }) %>

<h1>Projects</h1>
<p class="muted">Manage your project portfolio. Add a project image by uploading a file or pasting an image URL.</p>

<div class="admin-split">
  <div class="admin-list">
    <% projects.forEach(function(p) { %>
      <div class="admin-row">
        <div class="admin-thumb">
          <% if (p.image) { %><img src="<%= p.image %>" alt=""><div class="thumb-placeholder" style="display:none"><span>?</span></div><% } else { %><div class="thumb-placeholder"><span><%= p.category %></span></div><% } %>
        </div>
        <div class="admin-row-main">
          <strong><%= p.title %></strong>
          <span class="muted small"><%= p.category %> · <%= p.date %> — <%= p.description %></span>
        </div>
        <button class="btn btn-outline btn-sm" onclick="editProject('<%= p.id %>')">Edit</button>
        <form method="post" action="/admin/projects/delete" style="display:inline" onsubmit="return confirm('Delete this project?')">
          <input type="hidden" name="id" value="<%= p.id %>">
          <button type="submit" class="btn btn-danger btn-sm">Delete</button>
        </form>
      </div>
    <% }) %>
    <% if (!projects.length) { %><p class="muted">No projects yet.</p><% } %>
  </div>

  <div class="admin-form-card">
    <h3>Add / Edit Project</h3>
    <form method="post" action="/admin/projects/save" id="project-form">
      <input type="hidden" name="id" id="project-id" value="">
      <div class="field"><label>Title</label><input type="text" name="title" id="project-title" required></div>
      <div class="field-row">
        <div class="field"><label>Category</label><input type="text" name="category" id="project-category"></div>
        <div class="field"><label>Year</label><input type="text" name="date" id="project-date"></div>
      </div>
      <div class="field"><label>Description</label><textarea name="description" id="project-description" rows="4" required></textarea></div>
      <div class="field">
        <label>Project image</label>
        <input type="file" id="project-image-file" accept="image/*" class="file-to-dataurl" data-target="project-image">
        <p class="muted small">Or paste an image URL:</p>
        <input type="text" name="image" id="project-image" placeholder="https://...">
      </div>
      <button type="submit" class="btn btn-primary">Save Project</button>
      <button type="button" class="btn btn-outline" onclick="clearProject()">Clear</button>
    </form>
  </div>
</div>

<script src="/js/admin.js"></script>
<script>
  var projectsData = <%- JSON.stringify(projects) %>;
  window.PROJECTS = projectsData;
  function editProject(id) {
    var p = projectsData.find(function (x) { return x.id === id; });
    if (!p) return;
    document.getElementById('project-id').value = p.id;
    document.getElementById('project-title').value = p.title;
    document.getElementById('project-category').value = p.category;
    document.getElementById('project-date').value = p.date;
    document.getElementById('project-description').value = p.description;
    document.getElementById('project-image').value = p.image || '';
  }
  function clearProject() {
    document.getElementById('project-form').reset();
    document.getElementById('project-id').value = '';
  }
</script>

<%- include('_foot') %>
